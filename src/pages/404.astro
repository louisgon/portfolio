---
import '../styles/fonts.css';
import '../styles/base.css';
import { srcset, webp } from '../lib/assets';
import { BASE } from '../lib/pages';
import { LOGO } from '../lib/skills';

const [planet, planetSet] = await Promise.all([webp('p8'), srcset('p8')]);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Page not found · Louis Gonzalez</title>
<link rel="icon" href={`${BASE}favicon.ico`} sizes="48x48">
<link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml">
<link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`}>
</head>
<body>
<main>
<a class="logo" href={BASE} aria-label="Louis Gonzalez, home"><svg viewBox="0 0 4 5" aria-hidden="true"><path fill="currentColor" d={LOGO} /></svg></a>
<div class="stage">
<div class="digits disp" aria-hidden="true"><span>4</span><span class="zero"><img src={planet} srcset={planetSet} sizes="(max-aspect-ratio: 1/1) 28vw, min(27vw, 40vh)" alt=""><span class="plane"><span class="spin"><span class="moon"><i></i></span></span></span></span><span>4</span></div>
<div class="row">
<div><h1 class="disp">Page not found</h1><p>That link is out of date or mistyped.</p></div>
<a class="btn" href={BASE}>Back to home</a>
</div>
</div>
</main>
</body>
</html>

<style>
  main { --u: min(1vw, 1.5vh); --stars: radial-gradient(1px 1px at 12% 22%, #fff, transparent), radial-gradient(1px 1px at 72% 12%, #cfe6ff, transparent), radial-gradient(1.4px 1.4px at 38% 62%, #fff, transparent), radial-gradient(1px 1px at 88% 48%, #ffe9cf, transparent), radial-gradient(1px 1px at 55% 88%, #fff, transparent), radial-gradient(1.6px 1.6px at 22% 78%, #bcdcff, transparent), radial-gradient(1px 1px at 92% 82%, #fff, transparent), radial-gradient(1px 1px at 5% 52%, #dbe9ff, transparent); position: relative; display: grid; place-items: center; min-height: 100vh; min-height: 100svh; padding: 84px clamp(20px, 5vw, 72px) 40px; background: var(--stars); background-size: 340px 340px; }
  .logo { position: absolute; left: clamp(20px, 5vw, 72px); top: 28px; color: var(--fg); }
  .logo svg { display: block; width: 20px; height: 25px; }
  .stage { width: min(100%, calc(var(--u) * 90)); will-change: transform, opacity; backface-visibility: hidden; animation: arrive .7s var(--ease-out) both; }
  .digits { display: flex; justify-content: space-between; align-items: center; font-size: calc(var(--u) * 31); line-height: 1; color: var(--fg); }
  .zero { --d: calc(var(--u) * 27); --orbit: .67; position: relative; flex: none; width: var(--d); aspect-ratio: 1; transform-style: preserve-3d; }
  .zero img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .plane, .spin { position: absolute; inset: 0; transform-style: preserve-3d; }
  .plane { transform: rotate3d(0, 0, 1, -14deg) rotate3d(1, 0, 0, 76deg); }
  .spin { will-change: transform; animation: spin 16s linear infinite; }
  .moon { position: absolute; left: 50%; top: 50%; width: 10%; aspect-ratio: 1; margin: -5% 0 0 -5%; transform: translate3d(calc(var(--d) * var(--orbit)), 0, 0); transform-style: preserve-3d; }
  .moon i { display: block; width: 100%; height: 100%; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #d8dfe8, #1b1e26 78%); box-shadow: 0 0 8px rgb(200 220 255 / 18%); will-change: transform; backface-visibility: hidden; animation: face 16s linear infinite; }
  .row { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 20px; margin-top: calc(var(--u) * 6); }
  h1 { margin: 0; font-size: clamp(26px, calc(var(--u) * 4.2), 60px); line-height: 1; }
  p { margin: 14px 0 0; color: var(--dim); font-size: 18px; }
  @keyframes arrive { from { opacity: 0; transform: translate3d(0, 22px, 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
  @keyframes spin { to { transform: rotate3d(0, 0, 1, 360deg); } }
  @keyframes face { from { transform: rotate3d(0, 0, 1, 0deg) rotate3d(1, 0, 0, -76deg); } to { transform: rotate3d(0, 0, 1, -360deg) rotate3d(1, 0, 0, -76deg); } }
  @media (max-aspect-ratio: 1/1) {
    main { --u: 1vw; }
    .stage { width: 100%; }
    .digits { font-size: calc(var(--u) * 32); }
    .zero { --d: calc(var(--u) * 28); --orbit: .55; }
    .row { margin-top: calc(var(--u) * 24); }
  }
  @media (max-height: 500px) { main { padding-block: 60px 20px; } .logo { top: 18px; } .row { margin-top: calc(var(--u) * 3); } p { margin-top: 6px; font-size: 16px; } }
  @media (prefers-reduced-motion: reduce) {
    .spin, .moon i { animation: none; }
    .moon i { transform: rotate3d(1, 0, 0, -76deg); }
    .stage { animation-name: fade; }
    @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  }
</style>
