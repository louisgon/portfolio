---
import Divider from './Divider.astro';
import Heading from './Heading.astro';
import { srcset, webp } from '../lib/assets';

const [pilot, pilotSet] = await Promise.all([webp('pilot'), srcset('pilot')]);
---
<section class="s" id="pilot">
  <Divider n={4} name="About" />
  <div class="holo-wrap rv"><div class="holo" id="holo"><img id="pilotImg" alt="Portrait of Louis Gonzalez" data-src={pilot} data-srcset={pilotSet} sizes="(max-width: 860px) 300px, 440px" loading="lazy" /><div class="lines" aria-hidden="true"></div><div class="sheen" aria-hidden="true"></div><div class="rim" aria-hidden="true"></div><div class="sig" aria-hidden="true"></div><div class="hud"></div></div></div>
  <div class="pt" data-stage>
    <Heading lines={['Hi, I’m', 'Louis']} />
    <p class="lead st" style="--i:2">I’ve worked on the web since 2013, and today I’m a senior developer at Goodfolks. My work covers content systems, APIs and the websites and apps people use.</p>
    <ol class="roles" id="roles">
      <li class="now"><span class="yr disp">2024<small>to now</small></span><div><b>Senior Developer</b> <span class="co">· Goodfolks</span><em>Full stack development on established client sites and apps.</em></div></li>
      <li><span class="yr disp">2022<small>to 2024</small></span><div><b>Web Developer</b> <span class="co">· Goodfolks</span><em>WordPress, Craft CMS, HubSpot and Rails projects for clients.</em></div></li>
      <li><span class="yr disp">2020<small>to 2022</small></span><div><b>Frontend Developer</b> <span class="co">· Calibrate</span><em>Interactive websites for agency clients.</em></div></li>
      <li><span class="yr disp">2013<small>to 2020</small></span><div><b>Freelance</b><em>Independent web projects for global brands.</em></div></li>
    </ol>
  </div>
</section>
