---
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/backdrop.css';
import '../styles/hero.css';
import '../styles/nav.css';
import '../styles/intro.css';
import '../styles/stack.css';
import '../styles/work.css';
import '../styles/clients.css';
import '../styles/about.css';
import '../styles/contact.css';
import '../styles/footer.css';
import '../styles/case.css';
import '../styles/state.css';
import { getSiteData } from '../lib/site';
import { BASE, pageMeta } from '../lib/pages';
import syncopate from '@fontsource/syncopate/files/syncopate-latin-700-normal.woff2?url';
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import syncopateExt from '@fontsource/syncopate/files/syncopate-latin-ext-700-normal.woff2?url';
import lateFonts from '../styles/fonts-late.css?inline';

interface Props { open?: number }
const { open } = Astro.props;
const site = await getSiteData();
const data = JSON.stringify({ ...site, projects: site.projects.map(({ story, ...p }) => p) }).replace(/</g, '\\u003c');
const page = pageMeta(open === undefined ? undefined : site.projects[open]);
---
<!doctype html>
<html lang="en" class={open === undefined ? undefined : 'case-lock'}>
<head>
<meta charset="utf-8">
{!__REVIEW__ && !__INDEX__ && <meta name="robots" content="noindex">}
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{page.title}</title>
<meta name="description" content={page.description}>
<link rel="canonical" href={new URL(page.path, Astro.site).href}>
<link rel="icon" href={`${BASE}favicon.ico`} sizes="48x48">
<link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml">
<link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`}>
<meta property="og:type" content="website">
<meta property="og:title" content={page.title}>
<meta property="og:description" content={page.description}>
<meta property="og:url" content={new URL(page.path, Astro.site).href}>
<meta property="og:image" content={new URL('/og.jpg', Astro.site).href}>
<meta name="twitter:card" content="summary_large_image">
<style is:inline id="late" media={open === undefined ? 'not all' : undefined} set:html={lateFonts}></style>
<script is:inline>history.scrollRestoration = 'manual'; try { const n = performance.getEntriesByType('navigation')[0]; if ((location.hash.length > 1 && location.hash !== '#hero') || (/reload|back_forward/.test(n?.type ?? '') && +(sessionStorage.getItem('space-y') ?? 0) > innerHeight * 0.5)) { document.documentElement.classList.add('landing'); document.getElementById('late')?.removeAttribute('media'); } } catch {}</script>
<noscript><link rel="stylesheet" href={`${BASE}noscript.css`}></noscript>
<script type="application/json" id="site-data" set:html={data}></script>
</head>
<body class={open === undefined ? 'hi-nav hi-main' : 'hi-nav hi-main case-open'}>
<link rel="preload" href={syncopate} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin>
{open !== undefined && <link rel="preload" href={syncopateExt} as="font" type="font/woff2" crossorigin>}
<slot />
<script>import '../scripts/boot';</script>
</body>
</html>
