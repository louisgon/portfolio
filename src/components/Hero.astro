---
import { avif, haze, shade, small, webp } from '../lib/assets';

const tall = '(max-aspect-ratio: 17/20)', low = `${tall} and (max-width: 500px) and (max-height: 860px) and (max-resolution: 1.8dppx)`, w = small('hero/bg-tall');
const [wideAvif, wideWebp, tallAvif, tallWebp, lowAvif, lowWebp, wideHaze, tallHaze] = await Promise.all([avif('hero/bg-wide'), webp('hero/bg-wide'), avif('hero/bg-tall'), webp('hero/bg-tall'), avif('hero/bg-tall', w), webp('hero/bg-tall', w), haze('hero/bg-wide', 5, 6), haze('hero/bg-tall', 5, 8, 9, 15)]), copyShade = await shade(26);
const hazeCss = `#hero{--shade:${copyShade}}#hero .ph{background:${wideHaze}}@media ${tall}{#hero .ph{background:${tallHaze}}}`;
---
<section id="hero" aria-label="LG-01 above a desert world.">
  <div class="art" id="art" aria-hidden="true">
    <div class="ph"></div>
    <style is:inline set:html={hazeCss}></style>
    <picture class="bg"><source media={low} type="image/avif" srcset={lowAvif}><source media={low} type="image/webp" srcset={lowWebp}><source media={tall} type="image/avif" srcset={tallAvif}><source media={tall} type="image/webp" srcset={tallWebp}><source type="image/avif" srcset={wideAvif}><img src={wideWebp} alt="" fetchpriority="low"></picture>
    <canvas id="orbit"></canvas>
  </div>
  <div class="vig" id="vig" aria-hidden="true"></div>
  <div class="scrim"></div>
  <div class="copy">
    <h1 class="hl disp"><span class="ln"><span>Louis</span></span><span class="ln k"><span>Gonzalez.</span></span></h1>
    <p class="hs">I’m a senior developer in Dallas. I build websites and apps.</p>
    <div class="hc"><a class="btn" href="#work">View the work</a><a class="btn ghost" href="#contact">Get in touch</a></div>
  </div>
  <button type="button" class="fly" id="fly" aria-label="Fly LG-01"></button>
  <div class="hint mono" aria-hidden="true">Scroll to explore</div>
  <div class="best mono" aria-hidden="true" id="bestLine" hidden>LG-01 · Best <b id="best0">00<i class="sep"></i>00</b></div>
  <div class="hud" id="hud" data-nosnippet tabindex="-1" aria-label="LG-01 flight" inert>
    <div class="clk" aria-hidden="true"><b id="clock">00<i class="sep"></i>00</b><div class="hull"><span class="mono">Hull</span><div class="lv" id="lv"><i></i><i></i><i></i></div></div><div class="lvl mono" id="lvl"><span id="lvN">Level 01</span><i class="bar"><b id="xpFill"></b></i></div><div class="build" id="build"></div><div class="pick mono" id="pick" aria-hidden="true"></div></div>
    <div class="kc mono" aria-hidden="true">Kills<b id="kills">0</b><span class="bt">Best <em id="best1">00<i class="sep"></i>00</em></span></div>
    <div class="ctl mono" aria-hidden="true" id="ctl"><kbd>WASD</kbd> or arrows to steer</div>
    <button type="button" class="pz" id="pz" aria-label="Pause"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></button>
    <button type="button" class="land" id="land">Land <kbd>Esc</kbd></button>
    <div class="boss" id="bossBar" aria-hidden="true"><span class="mono" id="bossName">Rival flagship</span><i><b id="bossFill"></b></i></div>
    <div class="msg" id="msg" aria-hidden="true"><b id="msgB"></b><span class="mono" id="msgS"></span></div>
    <div class="panel" id="card" role="dialog" aria-modal="true" aria-labelledby="cardT">
      <div class="chd"><div class="mono" id="cardT">Level 02</div><b class="ttl" id="cardH"></b><div class="sub mono" id="cardSub"></div></div>
      <div class="cmd" id="cardBody"><b class="big" id="cardBig">00<i class="sep"></i>00</b><div class="nb mono" id="cardBest">New best</div><div class="rs mono" id="cardStats"></div><div class="bld" id="cardBuild"></div><div class="inv" id="cardInfo"></div><div class="opts" id="opts"></div></div>
      <div class="hc" id="cardActions"><span class="kh mono" id="cardHint" aria-hidden="true"></span><button type="button" class="btn ghost" id="cardBack">Land</button><button type="button" class="btn" id="cardMore">Fly again</button></div>
    </div>
  </div>
  <div class="sr" aria-live="polite" id="live"></div>
</section>
