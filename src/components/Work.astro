---
import Divider from './Divider.astro';
import Heading from './Heading.astro';
import { getProjects } from '../lib/site';
import { REACH, moonsHTML } from '../lib/planets';
import { nn } from '../lib/sections';
import { workURL } from '../lib/pages';
import { srcset } from '../lib/assets';

const projects = await getProjects();
const planets = await Promise.all(projects.map((p) => srcset(`p${p.order}`)));
const sizes = '(max-width: 860px) clamp(84px, 24vw, 112px), clamp(240px, 27vw, 440px)';
---
<section class="s" id="work">
  <Divider n={3} name="Work" />
  <div class="hd" data-stage>
    <Heading lines={['Selected', 'work']} />
  </div>
  <div id="projects">
    {projects.map((p, i) => (
      <article class="proj" data-i={i} aria-labelledby={`pt${i}`} style={`--rx:${REACH[i][0]};--ry:${REACH[i][1]}`}>
        <div class="planet" aria-hidden="true"><img data-src={p.planet} data-srcset={planets[i]} sizes={sizes} alt="" loading="lazy" /><Fragment set:html={moonsHTML(i)} /></div>
        <a class="pic rv" href={workURL(p.id)} data-case aria-label={`${p.title} case study`}>
          <img data-src={p.shot} alt="" loading="lazy" />
          <div class="hud"></div>
          <div class="edge"></div>
          <div class="scan"></div>
          <div class="tag" data-nosnippet aria-hidden="true"><b>{new URL(p.url).hostname.replace(/^www\./, '')}</b></div>
        </a>
        <div class="rv">
          <div class="num mono" data-nosnippet aria-hidden="true">{nn(i + 1)} / {nn(projects.length)}</div>
          <h3 class="disp" id={`pt${i}`}><a href={workURL(p.id)} data-case>{p.title}</a></h3>
          <div class="team mono">{p.team}</div>
          <p>{p.fact}</p>
          <div class="acts">
            <a class="btn sm" href={workURL(p.id)} data-case>Case study</a>
            <a class="btn ghost sm" href={p.url} target="_blank" rel="noopener">Visit site<span class="sr"> (opens in a new tab)</span></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
