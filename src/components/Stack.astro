---
import Divider from './Divider.astro';
import Heading from './Heading.astro';
import { CARD_GRID, LOGO, SKILLS } from '../lib/skills';
---
<section class="s" id="stack">
  <Divider n={2} name="Skills" />
  <div class="sgrid" aria-hidden="true"><i></i></div>
  <canvas id="bus" aria-hidden="true"></canvas>
  <div class="hd" data-stage>
    <Heading lines={['My skills']} />
  </div>
  <div class="table" id="table" tabindex="0" role="region" aria-label="Skill cards">
    {SKILLS.map((c) => (
      <div class="slot">
        <div class="card">
          <div class="f bk" style="transform:rotate3d(0,1,0,180deg)"><Fragment set:html={CARD_GRID} /><svg class="lg" viewBox="0 0 4 5"><path fill="currentColor" d={LOGO} /></svg></div>
          <div class="f fr" style="transform:none">
            <div class="hdr"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={c.ic} /></span></div>
            <h3>{c.t}</h3>
            <p class="d">{c.d}</p>
            <ul>{c.items.map((x, i) => <li style={`--i:${i}`}><i></i><span>{x}</span></li>)}</ul>
            <div class="shine"></div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
